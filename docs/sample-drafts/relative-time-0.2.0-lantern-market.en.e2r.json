{
  "version": "1.0",
  "entities": [
    {
      "id": "lantern-market",
      "name": "Lantern Market",
      "description": "A fictional neighborhood evening market that gathers around small food stalls."
    },
    {
      "id": "mei-organizer",
      "name": "Mei",
      "description": "The market organizer who decides when the stalls can safely reopen."
    },
    {
      "id": "ren-electrician",
      "name": "Ren",
      "description": "An electrician called to inspect the market's damaged power circuit."
    }
  ],
  "events": [
    {
      "id": "power-outage",
      "name": "The market loses power",
      "description": "A sudden fault darkens the Lantern Market while the evening stalls are open."
    },
    {
      "id": "lanterns-lit",
      "name": "Stallholders light the lanterns",
      "description": "The stallholders set out battery lanterns so visitors can see while the power is off."
    },
    {
      "id": "circuit-isolated",
      "name": "Ren isolates the damaged circuit",
      "description": "Ren separates the faulty circuit from the rest of the market's electrical supply."
    },
    {
      "id": "market-reopens",
      "name": "The market reopens in lantern light",
      "description": "Mei invites visitors back after the lanterns are ready and the damaged circuit is isolated."
    }
  ],
  "relations": [
    {
      "id": "outage-before-lanterns",
      "sourceId": "lanterns-lit",
      "targetId": "power-outage",
      "extensions": {
        "draft.github.sukoyaka-dopeness.relative-time": {
          "type": "relative-position",
          "relation": "before"
        }
      }
    },
