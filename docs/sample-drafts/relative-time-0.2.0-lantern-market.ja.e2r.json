{
  "version": "1.0",
  "entities": [
    {
      "id": "lantern-market",
      "name": "灯り市",
      "description": "小さな屋台が集まる、架空の地域の夕方市です。"
    },
    {
      "id": "mei-organizer",
      "name": "メイ",
      "description": "屋台を安全に再開できる時刻を判断する市の主催者です。"
    },
    {
      "id": "ren-electrician",
      "name": "レン",
      "description": "市の電気回路を点検するために呼ばれた電気技師です。"
    }
  ],
  "events": [
    {
      "id": "power-outage",
      "name": "市の電気が消える",
      "description": "夕方の市が開かれている間に突然の故障で灯りが消えます。"
    },
    {
      "id": "lanterns-lit",
      "name": "出店者がランタンを灯す",
      "description": "停電の間も来場者が歩けるよう、出店者が電池式ランタンを置きます。"
    },
    {
      "id": "circuit-isolated",
      "name": "レンが故障回路を切り離す",
      "description": "レンが故障した回路を市の電気設備から切り離します。"
    },
    {
      "id": "market-reopens",
      "name": "ランタンの灯りで市が再開する",
      "description": "ランタンの準備と故障回路の切り離しが済み、メイが来場者を迎えます。"
    }
  ],
  "relations": [
    {
      "id": "outage-before-lanterns",
      "sourceId": "lanterns-lit",
      "targetId": "power-outage",
      "extensions": {
        "draft.github.sukoyaka-dopeness.relative-time": {
          "type": "relative-position",
          "relation": "before"
        }
      }
    },
    {
      "id": "outage-before-circuit-isolated",
      "sourceId": "circuit-isolated",
      "targetId": "power-outage",
      "extensions": {
        "draft.github.sukoyaka-dopeness.relative-time": {
          "type": "relative-position",
          "relation": "before"
        }
      }
    },
    {
      "id": "lanterns-before-reopening",
      "sourceId": "market-reopens",
      "targetId": "lanterns-lit",
      "extensions": {
        "draft.github.sukoyaka-dopeness.relative-time": {
          "type": "relative-position",
          "relation": "before"
        }
      }
    },
    {
      "id": "circuit-before-reopening",
      "sourceId": "market-reopens",
      "targetId": "circuit-isolated",
      "extensions": {
        "draft.github.sukoyaka-dopeness.relative-time": {
          "type": "relative-position",
          "relation": "before"
        }
      }
    },
    { "id": "outage-at-market", "sourceId": "power-outage", "targetId": "lantern-market", "name": "で" },
    { "id": "lanterns-at-market", "sourceId": "lanterns-lit", "targetId": "lantern-market", "name": "で" },
    { "id": "circuit-at-market", "sourceId": "circuit-isolated", "targetId": "lantern-market", "name": "で" },
    { "id": "reopening-at-market", "sourceId": "market-reopens", "targetId": "lantern-market", "name": "で" },
    { "id": "lanterns-set-up-by-stallholders", "sourceId": "lanterns-lit", "targetId": "mei-organizer", "name": "が運営" },
    { "id": "circuit-checked-by-ren", "sourceId": "circuit-isolated", "targetId": "ren-electrician", "name": "が担当" },
    { "id": "reopening-approved-by-mei", "sourceId": "market-reopens", "targetId": "mei-organizer", "name": "が判断" }
  ],
  "extensions": {
    "metadata": {
      "datasetId": "draft-relative-time-lantern-market-ja",
      "title": "停電のあとに再開する夜の市"
    },
    "draft.github.sukoyaka-dopeness.specification": {
      "specVersion": "0.1.0",
      "uses": [
        { "extension": "metadata", "version": "1.0.0" },
        {
          "extension": "draft.github.sukoyaka-dopeness.relative-time",
          "version": "0.2.0",
          "features": ["relative-position"]
        }
      ]
    }
  }
}
