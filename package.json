{
  "name": "e2r-spec",
  "version": "0.0.0",
  "private": true,
  "description": "Development tooling for the E2R specification.",
  "scripts": {
    "validate": "npm run validate:history && npm run validate:history-2-draft && npm run validate:relative-time-draft && npm run validate:coordinate-draft && npm run validate:names-draft && npm run validate:names-draft-ids && npm run validate:presentation-draft && npm run validate:liaisonscape-layout-draft && npm run validate:visual-review-result && npm run validate:apollo-sample && npm run validate:public-samples-coordinate-less",
    "validate:apollo-sample": "node scripts/validate-apollo-sample.mjs",
    "validate:coordinate-draft": "node scripts/validate-coordinate-draft-schema.mjs",
    "validate:history": "node scripts/validate-history-schema.mjs",
    "validate:history-2-draft": "node scripts/validate-history-2.0-draft-schema.mjs",
    "validate:relative-time-draft": "node scripts/validate-relative-time-draft-schema.mjs",
    "validate:names-draft": "node scripts/validate-names-draft-schema.mjs",
    "validate:names-draft-ids": "node scripts/validate-names-draft-id-uniqueness.mjs",
    "validate:presentation-draft": "node scripts/validate-presentation-draft-schema.mjs",
    "validate:liaisonscape-layout-draft": "node scripts/validate-liaisonscape-layout-draft-schema.mjs",
    "validate:visual-review-result": "node scripts/validate-visual-review-result-schema.mjs",
    "validate:public-sample-mirrors": "node scripts/validate-public-sample-mirrors.mjs",
    "validate:public-samples-coordinate-less": "node scripts/validate-public-samples-coordinate-less.mjs",
    "validate:coordinate-interoperability": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/validate-coordinate-interoperability.mjs",
    "test:cdp": "node --test tools/edge-cdp/*.test.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
