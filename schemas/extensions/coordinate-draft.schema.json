{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sukoyaka-dopeness/e2r-spec/main/schemas/extensions/coordinate-draft.schema.json",
  "title": "E2R Coordinate Extension Draft 0.1.0",
  "description": "Coordinate-layer validation schema for a complete E2R Dataset using draft.github.sukoyaka-dopeness.coordinate at exact version 0.1.0.",
  "$comment": "Core validation and Coordinate semantic cross-reference validation remain separate. The normative requirements are in extensions/coordinate-extension-draft.md.",
  "type": "object",
  "required": [
    "version",
    "entities",
    "events",
    "relations"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coordinateCapableObject"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coordinateCapableObject"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationObject"
      }
    },
    "extensions": {
      "type": "object",
      "properties": {
        "draft.github.sukoyaka-dopeness.coordinate": {
          "$ref": "#/$defs/datasetPayload"
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "entities"
            ],
            "properties": {
              "entities": {
                "type": "array",
                "contains": {
                  "$ref": "#/$defs/coordinateOccurrence"
                }
              }
            }
          },
          {
            "required": [
              "events"
            ],
            "properties": {
              "events": {
                "type": "array",
                "contains": {
                  "$ref": "#/$defs/coordinateOccurrence"
                }
              }
            }
          }
        ]
      },
      "then": {
        "required": [
          "extensions"
        ],
        "properties": {
          "extensions": {
            "type": "object",
            "required": [
              "draft.github.sukoyaka-dopeness.coordinate"
            ],
            "properties": {
              "draft.github.sukoyaka-dopeness.coordinate": true
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "nonWhitespaceString": {
      "type": "string",
      "pattern": "\\S"
    },
    "coordinateOccurrence": {
      "type": "object",
      "required": [
        "extensions"
      ],
      "properties": {
        "extensions": {
          "type": "object",
          "required": [
            "draft.github.sukoyaka-dopeness.coordinate"
          ],
          "properties": {
            "draft.github.sukoyaka-dopeness.coordinate": true
          }
        }
      }
    },
    "datasetPayload": {
      "type": "object",
      "required": [
        "specVersion",
        "spaces"
      ],
      "properties": {
        "specVersion": {
          "const": "0.1.0"
        },
        "formatVersion": false,
        "spaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/spaceDefinition"
          }
        }
      },
      "additionalProperties": true
    },
    "spaceDefinition": {
      "type": "object",
      "required": [
        "id",
        "components"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonWhitespaceString"
        },
        "name": {
          "$ref": "#/$defs/nonWhitespaceString"
        },
        "kind": {
          "$ref": "#/$defs/nonWhitespaceString"
        },
        "externalReference": {
          "$ref": "#/$defs/externalReference"
        },
        "components": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "\\S"
          },
          "additionalProperties": {
            "$ref": "#/$defs/componentDefinition"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "not": {
              "type": "object",
              "required": [
                "externalReference"
              ],
              "properties": {
                "externalReference": true
              }
            }
          },
          "then": {
            "properties": {
              "components": {
                "type": "object",
                "additionalProperties": {
                  "not": {
                    "type": "object",
                    "required": [
                      "externalComponent"
                    ],
                    "properties": {
                      "externalComponent": true
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "componentDefinition": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/nonWhitespaceString"
        },
        "unit": {
          "$ref": "#/$defs/nonWhitespaceString"
        },
        "positiveDirection": {
          "$ref": "#/$defs/nonWhitespaceString"
        },
        "externalComponent": {
          "$ref": "#/$defs/nonWhitespaceString"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "period": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": true
    },
    "externalReference": {
      "type": "object",
      "required": [
        "authority",
        "identifier"
      ],
      "properties": {
        "authority": {
          "$ref": "#/$defs/nonWhitespaceString"
        },
        "identifier": {
          "$ref": "#/$defs/nonWhitespaceString"
        }
      },
      "additionalProperties": true
    },
    "coordinateCapableObject": {
      "type": "object",
      "properties": {
        "extensions": {
          "type": "object",
          "properties": {
            "draft.github.sukoyaka-dopeness.coordinate": {
              "$ref": "#/$defs/objectPayload"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "relationObject": {
      "type": "object",
      "properties": {
        "extensions": {
          "type": "object",
          "properties": {
            "draft.github.sukoyaka-dopeness.coordinate": false
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "objectPayload": {
      "type": "object",
      "required": [
        "coordinates"
      ],
      "properties": {
        "specVersion": false,
        "formatVersion": false,
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/coordinate"
          }
        }
      },
      "additionalProperties": true
    },
    "coordinate": {
      "type": "object",
      "required": [
        "spaceId",
        "values"
      ],
      "properties": {
        "spaceId": {
          "$ref": "#/$defs/nonWhitespaceString"
        },
        "values": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "\\S"
          },
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
