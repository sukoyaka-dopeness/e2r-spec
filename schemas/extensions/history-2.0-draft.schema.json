{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sukoyaka-dopeness/e2r-spec/main/schemas/extensions/history-2.0-draft.schema.json",
  "title": "E2R History Extension 2.0.0 Candidate",
  "description": "Structural validation schema for an extensions.history payload declared at exact candidate version 2.0.0.",
  "$comment": "The normative candidate requirements remain in extensions/history-extension-2.0-draft.md. Local assertion-ID uniqueness, exact version and Feature declarations, upgrade safety, and temporal diagnostics require validation beyond this payload schema.",
  "type": "object",
  "required": [
    "assertions"
  ],
  "properties": {
    "time": false,
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assertion"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "nonWhitespaceString": {
      "type": "string",
      "pattern": "\\S"
    },
    "temporalPosition": {
      "type": "object",
      "required": [
        "year"
      ],
      "properties": {
        "year": {
          "type": "integer"
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "minute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        },
        "second": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        },
        "timeZone": {
          "$ref": "#/$defs/nonWhitespaceString"
        },
        "offset": {
          "type": "string",
          "pattern": "^[+-][0-9]{2}:[0-9]{2}$"
        },
        "approximation": {
          "const": "circa"
        },
        "temporalOrder": false,
        "order": false
      },
      "dependentRequired": {
        "month": [
          "year"
        ],
        "day": [
          "year",
          "month"
        ],
        "hour": [
          "year",
          "month",
          "day"
        ],
        "minute": [
          "year",
          "month",
          "day",
          "hour"
        ],
        "second": [
          "year",
          "month",
          "day",
          "hour",
          "minute"
        ],
        "timeZone": [
          "year",
          "month",
          "day",
          "hour",
          "minute",
          "offset"
        ],
        "offset": [
          "year",
          "month",
          "day",
          "hour",
          "minute",
          "timeZone"
        ]
      },
      "additionalProperties": true
    },
    "temporalBoundary": {
      "type": "object",
      "required": [
        "occurrence"
      ],
      "properties": {
        "occurrence": {
          "enum": [
            "occurred",
            "not-occurred",
            "unknown"
          ]
        },
        "position": {
          "$ref": "#/$defs/temporalPosition"
        },
        "temporalOrder": false,
        "inclusive": false,
        "exclusive": false
      },
      "additionalProperties": true
    },
    "positionAssertion": {
      "type": "object",
      "required": [
        "id",
        "type",
        "position"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonWhitespaceString"
        },
        "type": {
          "const": "position"
        },
        "position": {
          "$ref": "#/$defs/temporalPosition"
        },
        "temporalOrder": {
          "type": "integer"
        },
        "earliest": false,
        "latest": false,
        "start": false,
        "end": false,
        "approximation": false
      },
      "additionalProperties": true
    },
    "boundedPointAssertion": {
      "type": "object",
      "required": [
        "id",
        "type",
        "earliest",
        "latest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonWhitespaceString"
        },
        "type": {
          "const": "bounded-point"
        },
        "earliest": {
          "$ref": "#/$defs/temporalPosition"
        },
        "latest": {
          "$ref": "#/$defs/temporalPosition"
        },
        "position": false,
        "temporalOrder": false,
        "start": false,
        "end": false,
        "approximation": false
      },
      "additionalProperties": true
    },
    "temporalExtentAssertion": {
      "type": "object",
      "required": [
        "id",
        "type",
        "start",
        "end"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonWhitespaceString"
        },
        "type": {
          "const": "temporal-extent"
        },
        "start": {
          "$ref": "#/$defs/temporalBoundary"
        },
        "end": {
          "$ref": "#/$defs/temporalBoundary"
        },
        "position": false,
        "temporalOrder": false,
        "earliest": false,
        "latest": false,
        "approximation": false
      },
      "additionalProperties": true
    },
    "assertion": {
      "oneOf": [
        {
          "$ref": "#/$defs/positionAssertion"
        },
        {
          "$ref": "#/$defs/boundedPointAssertion"
        },
        {
          "$ref": "#/$defs/temporalExtentAssertion"
        }
      ]
    }
  }
}
